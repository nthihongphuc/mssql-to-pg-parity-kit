# Example environment variables for demo/docker-compose.yml
# Copy to .env and replace all CHANGE_ME placeholders before starting Docker Compose.
# NEVER commit a populated .env file to source control.

# Source SQL Server 2022 (sql-src-01)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=retail_demo
MSSQL_USER=sa
MSSQL_SA_PASSWORD=CHANGE_ME_StrongSqlServerPass!2026

# Target PostgreSQL 16 (pg-target-01)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_demo
POSTGRES_USER=retail_admin
POSTGRES_PASSWORD=CHANGE_ME_StrongPostgresPass!2026

# Optional Audit PostgreSQL target (defaults to pg-target-01 in local demo)
AUDIT_PG_SCHEMA=migration_audit
